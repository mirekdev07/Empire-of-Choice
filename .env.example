# Database - Neon PostgreSQL (https://neon.tech) lub lokalny Postgres przez docker-compose
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DB?schema=public"

# NextAuth.js
# Wygeneruj wlasny sekret: `openssl rand -base64 48`
AUTH_SECRET="zmien-na-wlasny-losowy-sekret-min-32-znakow"
NEXTAUTH_URL="http://localhost:3000"

# Google OAuth (Google Cloud Console -> APIs & Services -> Credentials)
GOOGLE_CLIENT_ID="twoj-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="GOCSPX-twoj-google-client-secret"
