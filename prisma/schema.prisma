generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id             String     @id @default(cuid())
  email          String     @unique
  name           String?
  password       String?
  image          String?
  playGamesId    String?    @unique
  createdAt      DateTime   @default(now())
  currentSaveId  String?
  displayNameSet Boolean    @default(false)
  gameSaves      GameSave[]
  sessions       Session[]
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model GameSave {
  id                      String     @id @default(cuid())
  userId                  String
  name                    String     @default("Nowy zapis")
  chosenPath              String
  createdAt               DateTime   @default(now())
  lastPlayedAt            DateTime   @default(now()) @db.Timestamptz
  money                   Float      @default(100)
  followers               Float      @default(0)
  resources               Float      @default(50)   // Surowce dla Industrial
  reputation              Int        @default(10)
  efficiency              Float      @default(100)  // Efektywność 0-150% dla Industrial
  machineCondition        Float      @default(100)  // Kondycja maszyn 0-100% dla Industrial
  currentTier             Int        @default(1)
  totalEarnings           Float      @default(0)
  activeContracts         Json?
  autoAcceptContracts     Boolean    @default(false)
  autoAcceptMinReward     Int        @default(0)
  completedContractsCount Int        @default(0)
  completedLongTermCount  Int        @default(0)
  completedCollaborationsCount Int   @default(0)
  // Finance-specific fields
  aum                     Float      @default(0)    // Assets Under Management
  creditRating            String     @default("BBB") // AAA to D
  leverage                Float      @default(1.0)  // 1x to 20x
  marketPhase             String     @default("stable") // bull, stable, correction, bear, crash
  crashesSurvived         Int        @default(0)
  hedgingEnabled          Boolean    @default(false)
  // Prestige fields
  timesPrestiged          Int        @default(0)
  totalLifetimeEarnings   Float      @default(0)
  highestTierReached      Int        @default(1)
  prestigeProductionBonus Float      @default(1.0)
  prestigeMoneyBonus      Float      @default(0)
  prestigeFollowersBonus  Float      @default(0)
  prestigeReputationBonus Int        @default(0)
  prestigeResourcesBonus  Float      @default(0)
  prestigeEfficiencyBonus Float      @default(0)
  prestigeAumBonus        Float      @default(0)    // Finance prestige bonus
  prestigeRatingBonus     Int        @default(0)    // Finance prestige bonus (rating levels)
  claimedAchievements     Json       @default("[]") // Array of claimed achievement IDs
  // Buildings as JSON for atomic saves (no more relation issues)
  buildings               Json       @default("{}")
  // Snapshot of production for reliable offline earnings
  lastProductionPerSecond Float      @default(0)
  // Heartbeat - updated only during active gameplay, NOT on page close
  // Used for calculating offline earnings (lastPlayedAt is updated on every save)
  lastHeartbeat           DateTime   @default(now()) @db.Timestamptz
  // Ad bonus - expires after 30 minutes, gives +3 contract slots
  adBonusExpiresAt        DateTime?  @db.Timestamptz
  user                    User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Building model removed - buildings are now stored as JSON in GameSave
